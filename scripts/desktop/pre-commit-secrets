#!/usr/bin/env bash
# flybrain-secret-guard: blocks a commit that contains the saved Kaggle key, anything that looks like an
# API key, or a secret file. Installed by `fly kaggle setup` as .git/hooks/pre-commit.
SEC="${FLY_SECRETS:-$HOME/.config/flybrain/secrets.env}"
DIFF=$(git diff --cached -U0 --no-color)
if [ -f "$SEC" ]; then
  while IFS='=' read -r k v; do
    case "$k" in KAGGLE_KEY|KAGGLE_API_TOKEN) ;; *) continue ;; esac
    if [ ${#v} -ge 8 ] && grep -qF -- "$v" <<<"$DIFF"; then
      echo "BLOCKED: the staged changes contain your $k. Remove it, then commit again."; exit 1
    fi
  done < "$SEC"
fi
if grep -qE 'KGAT_[A-Za-z0-9_-]{10,}|"key"[[:space:]]*:[[:space:]]*"[0-9a-f]{32}"|gh[pousr]_[A-Za-z0-9]{30,}' <<<"$DIFF"; then
  echo "BLOCKED: the staged changes contain something that looks like an API key."; exit 1
fi
BAD=$(git diff --cached --name-only | grep -E '(^|/)(\.env|[^/]*\.env|kaggle\.json|secrets\.[a-z]+)$' | grep -vE '\.env\.example$' || true)
if [ -n "$BAD" ]; then
  echo "BLOCKED: secret file(s) staged: $BAD"; exit 1
fi
exit 0
