#!/usr/bin/env bash
# Control the training PC.   fly help
ROOT="$HOME/flybrain"
REPO="$ROOT/repo"
JOB="$ROOT/job.env"
U="systemctl --user"
cur() { [ -f "$JOB" ] && source "$JOB"; }

case "${1:-help}" in
  job)
    if [ -z "${2:-}" ]; then cur; echo "env=$ENV  steps=$STEPS  extra='$EXTRA'  run=$NAME"; exit 0; fi
    ENV="$2"; STEPS="${3:-2000000}"
    case "$ENV" in
      drone*)    BRAIN=data/flybrain_eye160_N4000.npz; EXTRA="${4:---random_start 0.5}"; NAME="$ENV-connectome-real-s0" ;;
      panda_waste) BRAIN=data/flybrain_eye160_smell_N4476.npz; EXTRA="${4:---privileged --grip_mode absolute --eye_adapt}"; NAME="$ENV" ;;
      panda_smell|panda_harvest|panda_pickripe|panda_pickmany) BRAIN=data/flybrain_eye160_smell_N4476.npz; EXTRA="${4:---random_start 0.3}"; NAME="$ENV-connectome-real-s0" ;;
      panda*)    BRAIN=data/flybrain_eye160_N4000.npz; EXTRA="${4:---random_start 0.3}"; NAME="$ENV-connectome-real-s0" ;;
      *_vision)  BRAIN=data/flybrain_cam16_N2500.npz;  EXTRA="${4:---action_rate 0.1 --random_start 0.5}"; NAME="$ENV-connectome-real-s0-slow" ;;
      *)         BRAIN=data/subset_flywire783_N1000.npz; EXTRA="${4:-}"; NAME="$ENV-connectome-real-s0" ;;
    esac
    case "$EXTRA" in
      *--head_fovy*) NAME="$NAME-2cam-2ripe-mem-zoom" ;;            # zoomed front camera (fine-tune): its own run
      *--smooth*) NAME="$NAME-2cam-2ripe-mem-smooth" ;;            # smoother picking (fine-tune): its own run
      *--head_cam*) NAME="$NAME-2cam-2ripe-mem" ;;                 # + front camera facing the truss: its own run
      *--memory*--return_start*|*--return_start*--memory*) NAME="$NAME-cam-2ripe-mem" ;;   # fly brain with memory
      *--memory*) NAME="$NAME-cam-mem" ;;                         # fly brain with memory: its own run
      *--return_start*) NAME="$NAME-cam-2ripe-ret" ;;              # two ripe + practise the second pick
      *--ripe_max\ 1*) NAME="$NAME-cam-1ripe" ;;                  # one ripe tomato per truss: its own run
      *--ripe_max\ 2*) NAME="$NAME-cam-2ripe" ;;                  # up to two ripe tomatoes: its own run
      *--wrist_cam*) NAME="$NAME-cam" ;;                           # wrist depth camera: its own run
      *--eye_adapt*) NAME="$NAME-adapt" ;;                         # light-adapting eyes: its own run
      *--light_log*) NAME="$NAME-light" ;;                         # wide-light retraining: its own run
      *--imitate*)   NAME="$NAME-imitate" ;;                       # teacher -> student: its own run
      *--init_from*) NAME="$NAME-ft" ;;                            # fine-tune = a new run next to its parent
    esac
    if [ "$ENV" = panda_pickmany ]; then                                       # phase 2c run names
      NAME="$ENV-connectome-real-s0-2cam-mem"
      case "$EXTRA" in *--bruise_end*) NAME="$NAME-strict" ;; esac
      case "$EXTRA" in *--max_steps*) NAME="$NAME-long" ;; esac          # more time per truss
      case "$EXTRA" in *--reward\ events*) NAME="$NAME-events" ;; esac    # banked (event) reward
      case "$EXTRA" in *--imitate*) NAME="$NAME-teacher2" ;; esac       # re-taught by teacher v2
      case "$EXTRA" in *--neuron_tau*) NAME="$NAME-tau" ;; esac         # brain: per-neuron time constants
      case "$EXTRA" in *--all_dn*) NAME="$NAME-dn" ;; esac              # brain: reads all its descending neurons
      case "$EXTRA" in *--imitate_grip_w*) NAME="$NAME-gw" ;; esac      # imitation: the close decision weighted
      case "$EXTRA" in *--imitate_segment*) NAME="$NAME-seg" ;; esac    # imitation: student drives stretches
      case "$EXTRA" in *--guide\ *) NAME="$NAME-guide" ;; esac         # Jump-Start RL: the teacher starts episodes
    fi
    if [ "$ENV" = panda_waste ]; then                                          # paper runs: controller, wiring, seed
      P=connectome; W=real
      case "$EXTRA" in *--policy\ mlp*) P=mlp ;; esac
      case "$EXTRA" in *--wiring\ shuffled*) W=shuffled ;; *--wiring\ rewired*) W=rewired ;; esac
      SD=$(echo "$EXTRA" | grep -o -- '--seed [0-9]*' | awk '{print $2}')
      NAME="$ENV-$P"; [ "$P" = connectome ] && NAME="$NAME-$W"; NAME="$NAME-s${SD:-0}"
      case "$EXTRA" in *--mlp_hidden*) NAME="$NAME-wide" ;; esac
      case "$EXTRA" in *--init_from*) NAME="$NAME-pre" ;; esac             # pretrained on another task first
    fi
    case "$EXTRA" in *--policy\ mlp*)                                         # MLP baselines: never a fly-brain run name
      if [ "$ENV" != panda_waste ]; then
        SD=$(echo "$EXTRA" | grep -o -- '--seed [0-9]*' | awk '{print $2}'); NAME="$ENV-mlp-s${SD:-0}"
      fi ;;
    esac
    printf 'ENV=%s\nBRAIN=%s\nSTEPS=%s\nEXTRA="%s"\nNAME=%s\n' "$ENV" "$BRAIN" "$STEPS" "$EXTRA" "$NAME" > "$JOB"
    echo "job set: $ENV, $STEPS steps, extra='$EXTRA' -> runs/$NAME  (fly restart to switch now)" ;;
  queue)
    # jobs that start one after another: each starts when the one before has FINISHED (not after a stop, a
    # failure or a reboot: training never starts by itself). fly queue | fly queue add ENV STEPS "EXTRA" | fly queue clear
    Q="$ROOT/queue.txt"; touch "$Q"
    case "${2:-list}" in
      add)   [ -n "${3:-}" ] || { echo 'usage: fly queue add ENV STEPS "EXTRA"'; exit 1; }
             echo "${3}|${4:-2000000}|${5:-}" >> "$Q"; echo "queued ($(wc -l < "$Q") waiting): $3 ${4:-2000000} ${5:-}" ;;
      clear) : > "$Q"; echo "queue cleared" ;;
      *)     if [ -s "$Q" ]; then nl -w2 -s'. ' "$Q" | tr '|' ' '; else echo "queue empty"; fi ;;
    esac ;;
  start)   $U start flybrain-train && echo "started: $("$0" job)" ;;
  stop)    $U stop flybrain-train && echo "stopped (checkpoint kept; fly start resumes)" ;;
  restart) $U restart flybrain-train && echo "restarted: $("$0" job)" ;;
  log)     cur; tail -n "${2:-40}" -f "$ROOT/logs/$NAME.log" ;;
  status)
    cur
    echo "job:      $ENV -> runs/$NAME   (service: $($U is-active flybrain-train))"
    grep -a -E "^\[progress\]" "$ROOT/logs/$NAME.log" 2>/dev/null | tail -1
    grep -a -E "^Eval num|^Success rate" "$ROOT/logs/$NAME.log" 2>/dev/null | tail -2
    grep -a "fps" "$ROOT/logs/$NAME.log" 2>/dev/null | tail -1 | tr -s ' ' | sed 's/|//g; s/^/speed:   /'
    T=$(sensors 2>/dev/null | grep -m1 -E "Package id 0|Tctl" | awk '{print $4}'); echo "CPU temp: ${T:-n/a}   RAM free: $(free -h | awk '/Mem/{print $7}')"
    echo "dashboard: http://$(hostname -I | awk '{print $1}'):8080" ;;
  export)
    # one zip with everything needed to look at a run (no big checkpoint backups)
    cur; R="${2:-$NAME}"; D="$ROOT/runs/$R"; [ -d "$D" ] || { echo "no run $R"; exit 1; }
    mkdir -p "$ROOT/exports"; Z="$ROOT/exports/${R}_$(date +%Y%m%d-%H%M).zip"
    tail -n 400 "$ROOT/logs/$R.log" > "$D/train_log_tail.txt" 2>/dev/null
    # only the newest progress video and the best model (all earlier videos stay on the PC/dashboard)
    LAST=$(ls "$D"/progress/*.mp4 2>/dev/null | sort | tail -1)
    (cd "$ROOT/runs" && zip -q -r "$Z" "$R" -x "*.bak" "*model_tmp*" "*.tmp" "$R/model.zip" "$R/progress/*" "$R/imitate_data.npz" "$R/imitate_policy.pt" "$R/imitate_best_policy.pt" \
        && { [ -z "$LAST" ] || zip -q "$Z" "$R/progress/$(basename "$LAST")"; })
    echo "saved $Z ($(du -h "$Z" | cut -f1))"
    echo "download on the Mac:  http://$(hostname -I | awk '{print $1}'):8080/exports/$(basename "$Z")"
    echo "or:                   scp flybox:$Z ~/Downloads/" ;;
  linkedin)
    # a high-quality presentation video (1080p, title + result cards) of a run's best brain
    cur; R="${2:-$NAME}"; D="$ROOT/runs/$R"; [ -d "$D" ] || { echo "no run $R"; exit 1; }
    A="${3:-16:9}"; mkdir -p "$ROOT/exports"; O="$ROOT/exports/${R}_linkedin_$(echo "$A" | tr ':' 'x')_$(date +%Y%m%d-%H%M).mp4"
    cd "$REPO" && nice -n 15 "$ROOT/.venv/bin/python" scripts/linkedin_video.py --run "$D" --aspect "$A" --out "$O" \
      && echo "download on the Mac:  http://$(hostname -I | awk '{print $1}'):8080/exports/$(basename "$O")" ;;
  update)  git -C "$REPO" pull && "$ROOT/.venv/bin/python" -m pip install -q -r "$REPO/requirements.txt" && $U restart flybrain-watch && echo "code updated (fly restart to use it for training)" ;;
  eval)    cur; cd "$REPO" && "$ROOT/.venv/bin/python" scripts/evaluate.py --run "$ROOT/runs/$NAME" --robustness --episodes "${2:-20}" ;;
  showcase) cur; cd "$REPO" && nice -n 15 "$ROOT/.venv/bin/python" scripts/showcase.py --run "$ROOT/runs/$NAME" --episodes "${2:-40}" ;;
  *) cat <<HELP
fly job                       show the current job
fly job ENV [STEPS] ["EXTRA"] set the job, e.g.  fly job maze3_vision 3000000
fly start | stop | restart    control training (after a reboot: fly start resumes from the last checkpoint)
fly status                    latest progress, eval, speed, CPU temperature
fly log [N]                   follow the training log (Ctrl+C to leave; training continues)
fly eval [EPISODES]           robustness tests on the best model
fly showcase [EPISODES]       film the best brain's successes on new random layouts (default 40 tried)
fly export [RUN]              zip a run (curves, results, best model, latest progress video, log) to send
fly linkedin [RUN] [ASPECT]   1080p presentation video of the best brain (ASPECT 16:9, 1:1 or 4:5) for posting
fly update                    get the latest code from GitHub
Dashboard with curves and progress videos: http://<this-pc>:8080
HELP
  ;;
esac
