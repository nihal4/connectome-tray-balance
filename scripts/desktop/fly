#!/usr/bin/env bash
# Control the training PC.   fly help
ROOT="$HOME/flybrain"
REPO="$ROOT/repo"
JOB="$ROOT/job.env"
U="systemctl --user"
cur() { [ -f "$JOB" ] && source "$JOB"; }

case "${1:-help}" in
  job)
    if [ -z "${2:-}" ]; then cur; echo "env=$ENV  steps=$STEPS  extra='$EXTRA'  run=$NAME"; exit 0; fi
    ENV="$2"; STEPS="${3:-2000000}"
    case "$ENV" in
      drone*)    BRAIN=data/flybrain_eye160_N4000.npz; EXTRA="${4:---random_start 0.5}"; NAME="$ENV-connectome-real-s0" ;;
      panda*)    BRAIN=data/flybrain_eye160_N4000.npz; EXTRA="${4:---random_start 0.3}"; NAME="$ENV-connectome-real-s0" ;;
      *_vision)  BRAIN=data/flybrain_cam16_N2500.npz;  EXTRA="${4:---action_rate 0.1 --random_start 0.5}"; NAME="$ENV-connectome-real-s0-slow" ;;
      *)         BRAIN=data/subset_flywire783_N1000.npz; EXTRA="${4:-}"; NAME="$ENV-connectome-real-s0" ;;
    esac
    printf 'ENV=%s\nBRAIN=%s\nSTEPS=%s\nEXTRA="%s"\nNAME=%s\n' "$ENV" "$BRAIN" "$STEPS" "$EXTRA" "$NAME" > "$JOB"
    echo "job set: $ENV, $STEPS steps, extra='$EXTRA' -> runs/$NAME  (fly restart to switch now)" ;;
  start)   $U start flybrain-train && echo "started: $("$0" job)" ;;
  stop)    $U stop flybrain-train && echo "stopped (checkpoint kept; fly start resumes)" ;;
  restart) $U restart flybrain-train && echo "restarted: $("$0" job)" ;;
  log)     cur; tail -n "${2:-40}" -f "$ROOT/logs/$NAME.log" ;;
  status)
    cur
    echo "job:      $ENV -> runs/$NAME   (service: $($U is-active flybrain-train))"
    grep -a -E "^\[progress\]" "$ROOT/logs/$NAME.log" 2>/dev/null | tail -1
    grep -a -E "^Eval num|^Success rate" "$ROOT/logs/$NAME.log" 2>/dev/null | tail -2
    grep -a "fps" "$ROOT/logs/$NAME.log" 2>/dev/null | tail -1 | tr -s ' ' | sed 's/|//g; s/^/speed:   /'
    T=$(sensors 2>/dev/null | grep -m1 -E "Package id 0|Tctl" | awk '{print $4}'); echo "CPU temp: ${T:-n/a}   RAM free: $(free -h | awk '/Mem/{print $7}')"
    echo "dashboard: http://$(hostname -I | awk '{print $1}'):8080" ;;
  export)
    # one zip with everything needed to look at a run (no big checkpoint backups)
    cur; R="${2:-$NAME}"; D="$ROOT/runs/$R"; [ -d "$D" ] || { echo "no run $R"; exit 1; }
    mkdir -p "$ROOT/exports"; Z="$ROOT/exports/${R}_$(date +%Y%m%d-%H%M).zip"
    tail -n 400 "$ROOT/logs/$R.log" > "$D/train_log_tail.txt" 2>/dev/null
    # only the newest progress video and the best model (all earlier videos stay on the PC/dashboard)
    LAST=$(ls "$D"/progress/*.mp4 2>/dev/null | sort | tail -1)
    (cd "$ROOT/runs" && zip -q -r "$Z" "$R" -x "*.bak" "*model_tmp*" "*.tmp" "$R/model.zip" "$R/progress/*" \
        && { [ -z "$LAST" ] || zip -q "$Z" "$R/progress/$(basename "$LAST")"; })
    echo "saved $Z ($(du -h "$Z" | cut -f1))"
    echo "download on the Mac:  http://$(hostname -I | awk '{print $1}'):8080/exports/$(basename "$Z")"
    echo "or:                   scp flybox:$Z ~/Downloads/" ;;
  update)  git -C "$REPO" pull && $U restart flybrain-watch && echo "code updated (fly restart to use it for training)" ;;
  eval)    cur; cd "$REPO" && "$ROOT/.venv/bin/python" scripts/evaluate.py --run "$ROOT/runs/$NAME" --robustness --episodes "${2:-20}" ;;
  *) cat <<HELP
fly job                       show the current job
fly job ENV [STEPS] ["EXTRA"] set the job, e.g.  fly job maze3_vision 3000000
fly start | stop | restart    control training (after a reboot: fly start resumes from the last checkpoint)
fly status                    latest progress, eval, speed, CPU temperature
fly log [N]                   follow the training log (Ctrl+C to leave; training continues)
fly eval [EPISODES]           robustness tests on the best model
fly export [RUN]              zip a run (curves, results, best model, latest progress video, log) to send
fly update                    get the latest code from GitHub
Dashboard with curves and progress videos: http://<this-pc>:8080
HELP
  ;;
esac
